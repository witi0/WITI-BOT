{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "01 - Instalar dependencias",
      "type": "shell",
      "command": "npm ci",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "02 - Ejecutar pruebas",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "03 - Compilar instalador Windows",
      "type": "shell",
      "command": "npm run dist:win",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "04 - SUBIR a GitHub y lanzar release 3.2.0",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/../02_SUBIR_Y_PUBLICAR_GITHUB.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
